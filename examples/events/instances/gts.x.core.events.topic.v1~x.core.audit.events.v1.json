{
  "id": "gts.x.core.events.topic.v1~x.core.audit.events.v1",
  "name": "audit",
  "description": "Audit trail events (settings changes, access control, compliance).",
  "retention": "P730D",
  "ordering": "global",
  "partitions": 6,
  "partitionKeyPath": "/key",
  "dedup": {
