{
  "$id": "gts://gts.x.core.iam.settings.v1~x.core.iam.security_policy.v1~x.core.iam.password_policy.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Password Policy Setting",
  "description": "Concrete security policy type for password complexity and rotation rules.",
  "type": "object",
  "allOf": [
    { "$ref": "gts://gts.x.core.iam.settings.v1~x.core.iam.security_policy.v1~" },
    {
      "type": "object",
      "properties": {
        "properties": {
          "type": "object",
          "required": ["minLength", "requireUppercase", "requireDigit", "requireSpecial", "maxAgeDays"],
          "properties": {
            "minLength": {
              "description": "Minimum password length.",
              "type": "integer"
            },
            "requireUppercase": {
              "description": "Whether at least one uppercase letter is required.",
              "type": "boolean"
            },
            "requireDigit": {
              "description": "Whether at least one digit is required.",
              "type": "boolean"
            },
            "requireSpecial": {
              "description": "Whether at least one special character is required.",
              "type": "boolean"
            },
            "maxAgeDays": {
              "description": "Maximum password age in days before forced rotation.",
              "type": "integer"
            }
          }
        }
      }
    }
  ]
}
