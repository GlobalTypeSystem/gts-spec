{
  "$id": "gts://gts.x.core.events.subscription.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event subscription",
  "description": "Selects events from a topic using GTS identifier patterns.",
  "type": "object",
  "required": ["id", "topic_id", "event_patterns"],
  "properties": {
    "id": { "type": "string", "x-gts-instance-ref": "/$id" },
    "topic_id": {
      "type": "string",
      "x-gts-instance-ref": "gts.x.core.events.topic.v1~"
    },
    "event_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "x-gts-pattern-ref": "gts.x.core.events.type.*"
      }
    }
  },
  "additionalProperties": false
}
