{
  "$id": "gts://gts.x.core.settings.type.v1~x.platform._.feature_new_dashboard.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature Flag: New Dashboard",
  "description": "Cascading boolean feature flag that enables the new dashboard experience. Inherits down the tenant hierarchy; each tenant may override it for their scope.",
  "type": "object",
  "allOf": [
    { "$ref": "gts://gts.x.core.settings.type.v1~" },
    {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "gts.x.core.settings.type.v1~x.platform._.feature_new_dashboard.v1~"
        },
        "value": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "When true the new dashboard experience is enabled.",
              "default": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "x-gts-traits": {
    "scope_class": "cascading",
    "data_classification": "public",
    "mode": "standard",
    "tenant_visible": true,
    "tenant_overridable": true,
    "barrier_traversable": true
  }
}
